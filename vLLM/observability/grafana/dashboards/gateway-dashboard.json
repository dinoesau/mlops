    {
      "id": 9,
      "type": "volkovlabs-echarts-panel",
      "title": "Flow project -> project/key_name -> model (Sankey)",
      "description": "Live flow from llm_requests_total by project,key_name,model. Requires volkovlabs-echarts-panel plugin. If plugin is missing, use panel 10 table fallback with the same query.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (project,key_name,model) (rate($metric{project!=\"\",key_name!=\"\"}[5m]))",
          "legendFormat": "{{project}}/{{key_name}} -> {{model}}"
        }
      ],
      "options": {
        "renderer": "canvas",
        "getOption": "const data = (typeof context !== 'undefined' && context.panel && context.panel.data) ? context.panel.data : { series: [] };\nconst links = [];\nconst nodes = new Set();\n(data.series || []).forEach((s) => {\n  const f = (s.fields && s.fields[1]) || {};\n  const labels = f.labels || s.labels || {};\n  const project = labels.project || '';\n  const key = labels.key_name || '';\n  const model = labels.model || 'unknown';\n  if (!project || !key) return;\n  let vals = (f.values && f.values.toArray) ? f.values.toArray() : (f.values || s.values || []);\n  if (!Array.isArray(vals)) vals = [];\n  const value = Math.max.apply(null, vals.map(Number).filter((v) => v > 0).concat([0]));\n  if (!value || value <= 0) return;\n  const mid = project + '/' + key;\n  nodes.add(project); nodes.add(mid); nodes.add(model);\n  links.push({ source: project, target: mid, value: value });\n  links.push({ source: mid, target: model, value: value });\n});\nreturn {\n  tooltip: { trigger: 'item' },\n  series: [{ type: 'sankey', data: [...nodes].map((n) => ({ name: n })), links: links, emphasis: { focus: 'adjacency' } }]\n};"
      }
    },
